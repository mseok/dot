# The user explicitly chose direct access to Slurm commands.
prefix_rule(
    pattern = [[
        "squeue", "/usr/bin/squeue", "/bin/squeue",
        "sinfo", "/usr/bin/sinfo", "/bin/sinfo",
        "sacct", "/usr/bin/sacct", "/bin/sacct",
        "scontrol", "/usr/bin/scontrol", "/bin/scontrol",
        "sbatch", "/usr/bin/sbatch", "/bin/sbatch",
        "srun", "/usr/bin/srun", "/bin/srun",
        "scancel", "/usr/bin/scancel", "/bin/scancel",
    ]],
    decision = "allow",
    justification = "Allow direct Slurm inspection, submission, execution, cancellation, and control operations",
    match = [
        "squeue --me",
        "/usr/bin/sinfo --Node",
        "sacct --starttime today",
        "scontrol show node compute01",
        "sbatch job.sh",
        "srun hostname",
        "scancel 12345",
    ],
    not_match = [
        "ssh compute01 squeue --me",
        "slurmrestd -a rest_auth/local",
    ],
)

# GPU state must be visible outside the filesystem sandbox.
prefix_rule(
    pattern = [["nvidia-smi", "/usr/bin/nvidia-smi", "/bin/nvidia-smi"]],
    decision = "allow",
    justification = "Inspect physical GPU usage before scheduler or direct execution decisions",
    match = [
        "nvidia-smi",
        "/usr/bin/nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader",
    ],
    not_match = ["watch nvidia-smi"],
)

# This is intentionally broad: the user explicitly allowed direct host-side
# launchers when scheduler allocation alone blocks an actually idle GPU.
prefix_rule(
    pattern = [[
        "bash", "/usr/bin/bash", "/bin/bash",
        "sh", "/usr/bin/sh", "/bin/sh",
        "env", "/usr/bin/env", "/bin/env",
        "python", "/usr/bin/python", "/bin/python",
        "python3", "/usr/bin/python3", "/bin/python3",
        ".venv/bin/python", "./.venv/bin/python",
        "uv", "/usr/bin/uv", "/usr/local/bin/uv",
    ]],
    decision = "allow",
    justification = "Allow broad host-side shell and Python launchers for user-approved direct execution; these commands can execute arbitrary code outside the sandbox",
    match = [
        "bash -lc 'python3 -V'",
        "env CUDA_VISIBLE_DEVICES=0 python3 job.py",
        "python3 job.py",
        ".venv/bin/python job.py",
        "uv run python job.py",
    ],
    not_match = [
        "rm -rf /tmp/example",
        "git status",
        "torchrun train.py",
    ],
)
