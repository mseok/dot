{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(brew:*)",
      "Bash(open:*)",
      "Bash(qlmanage:*)",
      "Bash(pbcopy:*)",
      "Bash(pbpaste:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(readlink:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(pixi:*)",
      "Bash(micromamba:*)",
      "WebFetch",
      "WebSearch",
      "mcp__context7"
    ]
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "printf \"\\033[01;32m%s@%s\\033[00m:\\033[01;34m%s\\033[00m\\033[01;33m%s\\033[00m\" \"$(whoami)\" \"$(hostname -s)\" \"$(pwd)\" \"$(git branch --show-current 2>/dev/null | sed 's/^/ (/;s/$/)/')\""
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": false
}
